{
  "info": {
    "name": "Employee Management API",
    "description": "Run in order (Collection Runner works). Start the backend first; see README. Uses HTTP Basic auth from the username/password collection variables (local defaults admin / admin123).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Check credentials",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        },
        "description": "200 with the username when the collection credentials are valid."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Create employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ]
        },
        "description": "201 Created with a Location header. Stores the new id in {{employeeId}}.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeCode\": \"EMP-016\",\n  \"fullName\": \"Riya Kapoor\",\n  \"email\": \"riya.kapoor@example.com\",\n  \"phone\": \"+91 98260 12345\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Software Engineer\",\n  \"joiningDate\": \"2024-09-02\",\n  \"salary\": 750000.0,\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('employeeId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create duplicate email (different case) \u2192 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ]
        },
        "description": "Emails are compared case-insensitively, so this conflicts with request 1.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeCode\": \"EMP-017\",\n  \"fullName\": \"Riya Kapoor\",\n  \"email\": \"RIYA.KAPOOR@EXAMPLE.COM\",\n  \"phone\": \"+91 98260 12345\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Software Engineer\",\n  \"joiningDate\": \"2024-09-02\",\n  \"salary\": 750000.0,\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Create with invalid fields \u2192 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ]
        },
        "description": "Returns fieldErrors for each invalid field.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeCode\": \"E\",\n  \"fullName\": \"\",\n  \"email\": \"not-an-email\",\n  \"phone\": \"12ab\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Engineer\",\n  \"joiningDate\": \"2999-01-01\",\n  \"salary\": -5,\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. List employees (default)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ]
        },
        "description": "page=0, size=10, sort=fullName,asc"
      }
    },
    {
      "name": "5. List with search, filters, paging and sort",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees?search=a&department=Engineering&status=ACTIVE&page=0&size=5&sort=salary,desc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ],
          "query": [
            {
              "key": "search",
              "value": "a"
            },
            {
              "key": "department",
              "value": "Engineering"
            },
            {
              "key": "status",
              "value": "ACTIVE"
            },
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "5"
            },
            {
              "key": "sort",
              "value": "salary,desc"
            }
          ]
        },
        "description": "All parameters are optional and combine with AND. Pages are zero-based; size 1-100."
      }
    },
    {
      "name": "6. List with unsupported sort \u2192 400",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees?sort=password,asc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ],
          "query": [
            {
              "key": "sort",
              "value": "password,asc"
            }
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. List departments",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees/departments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "departments"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "8. Get employee",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "{{employeeId}}"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "9. Update employee",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "{{employeeId}}"
          ]
        },
        "description": "Replaces editable fields. employeeCode must match the existing Employee ID.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeCode\": \"EMP-016\",\n  \"fullName\": \"Riya Kapoor\",\n  \"email\": \"riya.kapoor@example.com\",\n  \"phone\": \"+91 98260 12345\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Senior Software Engineer\",\n  \"joiningDate\": \"2024-09-02\",\n  \"salary\": 900000.0,\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Export CSV",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees/export?department=Engineering",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "export"
          ],
          "query": [
            {
              "key": "department",
              "value": "Engineering"
            }
          ]
        },
        "description": ""
      }
    },
    {
      "name": "11. Delete employee",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "{{employeeId}}"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204 No Content', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Get deleted employee \u2192 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "{{employeeId}}"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "13. List without credentials \u2192 401",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ]
        },
        "description": "Overrides the collection auth to show the JSON 401 response."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "employeeId",
      "value": "1"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "admin123"
    }
  ],
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  }
}